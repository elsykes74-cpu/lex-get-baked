{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-push-typecheck.sh",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\": \"REMINDER: Always include the live site hyperlink at the end of your response: https://lex-get-baked.vercel.app\"}'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
